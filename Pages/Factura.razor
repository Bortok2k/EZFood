@page "/Factura"

@using System.Text.Json;
@using System.Text.Json.Serialization;

@inject HttpClient Http
@inject SidebarService SidebarService
@implements IDisposable

<div class="content" style="padding:20px 40px; background:#d9d9d9;
                             min-height:100vh; display:flex; flex-direction:column; gap:20px;">

    <h2 style="margin:0;">Factura Electrónica</h2>

    <!-- Buscador por NIT -->
    <div style="display:flex; gap:10px; align-items:center;">
        <input placeholder="Buscar cliente por NIT..."
               value="@nitBusqueda"
               @oninput="e => nitBusqueda = e.Value?.ToString()"
               style="padding:10px 20px; border-radius:20px; border:none; width:280px;" />
        <button @onclick="BuscarCliente"
                style="background:#F28C45; border:none; padding:10px 20px;
                       border-radius:20px; color:white; cursor:pointer;">
            Buscar
        </button>
    </div>

    @if (clienteEncontrado != null)
    {
        <!-- Info cliente -->
        <div style="background:white; border-radius:15px; padding:20px; max-width:500px;">
            <h4 style="margin:0 0 10px;">Cliente encontrado</h4>
            <p style="margin:4px 0;"><strong>NIT:</strong> @clienteEncontrado.nit</p>
            <p style="margin:4px 0;"><strong>Nombre:</strong> @clienteEncontrado.nombre</p>
            <p style="margin:4px 0;"><strong>Correo:</strong> @clienteEncontrado.correo</p>
            <p style="margin:4px 0;"><strong>Dirección:</strong> @clienteEncontrado.direccion</p>
        </div>

        <!-- Selector de orden -->
        <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
            <label style="font-weight:600;">Seleccionar orden pagada:</label>
            <input placeholder="Buscar por mesa, fecha o ID..."
                   value="@searchOrden"
                   @oninput="e => searchOrden = e.Value?.ToString()"
                   style="padding:8px 15px; border-radius:20px; border:none; width:220px;" />
            <select @bind="ordenSeleccionadaId"
                    style="padding:8px 15px; border-radius:20px; border:none; background:white;">
                <option value="">-- Selecciona una orden --</option>
                @foreach (var orden in OrdenesPagadasFiltradas)
                {
                    <option value="@orden.orden_id">
                        @orden.mesa — $@orden.total — @orden.fecha
                    </option>
                }
            </select>
        </div>
        @if (string.IsNullOrWhiteSpace(searchOrden) && ordenesPagadas.Count > 50)
        {
            <span style="font-size:11px; color:#888;">
                Mostrando las 50 más recientes de @ordenesPagadas.Count — escribe para buscar en el resto.
            </span>
        }

        <button @onclick="GenerarFactura"
                disabled="@(string.IsNullOrEmpty(ordenSeleccionadaId))"
                style="background:#F28C45; border:none; padding:12px 30px;
                           border-radius:20px; color:white; cursor:pointer;
                           font-size:15px; font-weight:600; width:fit-content;">
            Generar Factura
        </button>
    }

    @if (mensajeError != null)
    {
        <p style="color:red;">@mensajeError</p>
    }
</div>

@if (showToast)
{
    <div style="position:fixed; top:24px; right:24px; display:flex; align-items:center; gap:10px;
                    padding:14px 22px; border-radius:14px; color:white; font-size:14px; font-weight:600;
                    box-shadow:0 6px 20px rgba(0,0,0,0.25); z-index:10001;
                    background:@(toastEsExito ? "#2ecc71" : "#e74c3c");">
        <span>@(toastEsExito ? "✅" : "⚠️")</span>
        <span>@toastMessage</span>
    </div>
}

@* Modal resumen factura *@
@if (showFacturaModal && facturaGenerada != null)
{
    <div class="comfirm-overlay">
        <div class="comfirm-box" style="width:500px; max-height:85vh; overflow-y:auto;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                <h3 style="margin:0; color:white;">
                    @(facturaGenerada.estado == "EMITIDA" ? "✅ Factura Emitida" : "⚠️ Factura Rechazada")
                </h3>
                @if (!string.IsNullOrEmpty(facturaGenerada.cufe))
                {
                    <div style="margin-top:10px; color:#ccc; font-size:11px; word-break:break-all;">
                        <strong>CUFE:</strong> @facturaGenerada.cufe
                    </div>
                    <div style="color:#ccc; font-size:11px;">
                        <strong>Ambiente:</strong> @facturaGenerada.ambiente_dian (validación mock)
                    </div>
                }
                <button @onclick="() => showFacturaModal = false"
                        style="background:transparent; border:none; color:white;
                           font-size:22px; cursor:pointer;">
                    ✕
                </button>
            </div>

            <!-- Número de factura -->
            <div style="background:#444; border-radius:10px; padding:10px;
                            margin-bottom:15px; color:#F28C45; font-weight:bold; text-align:center;">
                N° @facturaGenerada.factura_id.Substring(0, 8).ToUpper()
            </div>

            <!-- Datos del restaurante -->
            <div style="color:#ccc; font-size:12px; text-align:center; margin-bottom:15px;">
                <div style="font-weight:bold; color:white; font-size:14px;">SANTA CLARA GOURMET</div>
                <div>Bugalagrande, Valle del Cauca</div>
                <div>Régimen Simple de Tributación</div>
            </div>

            <!-- Datos del cliente -->
            <div style="background:#444; border-radius:10px; padding:12px; margin-bottom:15px;">
                <div style="color:#ccc; font-size:12px; margin-bottom:5px;">DATOS DEL CLIENTE</div>
                <div style="color:white; font-size:13px;">
                    <div><strong>NIT:</strong> @facturaGenerada.cliente_nit</div>
                    <div><strong>Nombre:</strong> @facturaGenerada.cliente_nombre</div>
                    <div><strong>Correo:</strong> @facturaGenerada.cliente_correo</div>
                    <div><strong>Dirección:</strong> @facturaGenerada.cliente_direccion</div>
                </div>
            </div>

            <!-- Info orden -->
            <div style="color:white; font-size:13px; margin-bottom:10px;">
                <div><strong>Mesa:</strong> @facturaGenerada.mesa</div>
                <div><strong>Fecha:</strong> @facturaGenerada.fecha</div>
                <div><strong>Hora:</strong> @facturaGenerada.hora</div>
            </div>

            <!-- Platos -->
            <div style="margin-bottom:15px;">
                <div style="color:#ccc; font-size:12px; margin-bottom:8px;">DETALLE</div>
                @foreach (var p in facturaGenerada.platos)
                {
                    <div style="display:flex; justify-content:space-between;
                                        padding:6px 10px; background:#444;
                                        border-radius:8px; margin-bottom:6px; color:white; font-size:13px;">
                        <span>@p.cantidad× @p.Descripcion</span>
                        <span>$@p.subtotal</span>
                    </div>
                }
            </div>

            <!-- Totales -->
            <div style="border-top:1px solid #555; padding-top:12px;">
                <div style="display:flex; justify-content:space-between; color:white; margin-bottom:6px;">
                    <span>Subtotal</span>
                    <span>$@facturaGenerada.subtotal</span>
                </div>
                <div style="display:flex; justify-content:space-between; color:#ccc; margin-bottom:6px; font-size:13px;">
                    <span>Impuesto al consumo (8%)</span>
                    <span>$@facturaGenerada.impuesto_consumo</span>
                </div>
                <div style="display:flex; justify-content:space-between;
                                color:white; font-weight:bold; font-size:16px;
                                background:#F28C45; padding:10px; border-radius:10px; margin-top:8px;">
                    <span>TOTAL</span>
                    <span>$@facturaGenerada.total</span>
                </div>
            </div>

            <div style="text-align:center; font-size:12px; margin-top:15px; font-weight:600;
                color:@(facturaGenerada.estado == "EMITIDA" ? "#2ecc71" : "#e74c3c");">
                Estado: @facturaGenerada.estado — Documento de prueba
            </div>

            @if (!string.IsNullOrEmpty(facturaGenerada.cufe))
            {
                <div style="margin-top:10px; color:#ccc; font-size:11px; word-break:break-all;">
                    <strong>CUFE:</strong> @facturaGenerada.cufe
                </div>
                <div style="color:#ccc; font-size:11px;">
                    <strong>Ambiente:</strong> @facturaGenerada.ambiente_dian (validación mock)
                </div>
            }

            @if (facturaGenerada.mensajes_validacion != null && facturaGenerada.mensajes_validacion.Any())
            {
                <div style="margin-top:10px; background:#5a1f1f; border-radius:10px; padding:10px; color:#ffb3b3; font-size:12px;">
                    <strong>Motivo de rechazo:</strong>
                    <ul style="margin:5px 0 0 15px; padding:0;">
                        @foreach (var msg in facturaGenerada.mensajes_validacion)
                        {
                            <li>@msg</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
}

@code {
    bool showToast = false;
    string toastMessage = "";
    bool toastEsExito = true;

    string nitBusqueda = "";
    string ordenSeleccionadaId = "";
    string? mensajeError = null;
    bool showFacturaModal = false;

    Cliente? clienteEncontrado = null;
    List<Orden> ordenesPagadas = new();
    FacturaData? facturaGenerada = null;

    protected override async Task OnInitializedAsync()
{
    // Leer orden_id de la URL, si viene desde "Cobrar y facturar"
    string? ordenIdDesdeUrl = null;
    var query = new Uri(Nav.Uri).Query;
    if (query.Contains("orden_id="))
    {
        var inicio = query.IndexOf("orden_id=") + "orden_id=".Length;
        var fin = query.IndexOf('&', inicio);
        ordenIdDesdeUrl = fin > 0 ? query[inicio..fin] : query[inicio..];
        ordenIdDesdeUrl = Uri.UnescapeDataString(ordenIdDesdeUrl);
    }

    await LoadOrdenesPagadas();

    if (!string.IsNullOrEmpty(ordenIdDesdeUrl))
    {
        ordenSeleccionadaId = ordenIdDesdeUrl;
    }
}

protected override void OnAfterRender(bool firstRender)
{
    if (firstRender)
    {
        SidebarService.SetButtons(
            @<button class="side-button" @onclick='() => Nav.NavigateTo("/caja")'>
                ← Volver a Caja
            </button>
        );
    }
}

    async Task LoadOrdenesPagadas()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<OrdenApiResponse>(
                $"{ApiConfig.BaseUrl}/Orden/ordenes");
            ordenesPagadas = response?.data
                ?.Where(o => o.estado_nombre?.ToLower() == "pagado")
                .OrderByDescending(o => o.fecha)
                .ThenByDescending(o => o.hora)
                .ToList() ?? new List<Orden>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            ordenesPagadas = new List<Orden>();
        }
    }

    string searchOrden = "";

    List<Orden> OrdenesPagadasFiltradas
    {
        get
        {
            List<Orden> baseList;

            if (string.IsNullOrWhiteSpace(searchOrden))
                baseList = ordenesPagadas.Take(50).ToList();
            else
                baseList = ordenesPagadas.Where(o =>
                    (o.mesa?.Contains(searchOrden, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (o.fecha?.Contains(searchOrden) ?? false) ||
                    (o.orden_id?.Contains(searchOrden, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    o.total.ToString().Contains(searchOrden)
                ).ToList();

            // Garantiza que la orden preseleccionada siempre aparezca en el <select>
            if (!string.IsNullOrEmpty(ordenSeleccionadaId) &&
                !baseList.Any(o => o.orden_id == ordenSeleccionadaId))
            {
                var seleccionada = ordenesPagadas.FirstOrDefault(o => o.orden_id == ordenSeleccionadaId);
                if (seleccionada != null) baseList.Insert(0, seleccionada);
            }

            return baseList;
        }
    }

    public void Dispose() { }

    async Task BuscarCliente()
    {
        mensajeError = null;
        clienteEncontrado = null;

        if (string.IsNullOrWhiteSpace(nitBusqueda)) return;

        try
        {
            var response = await Http.GetFromJsonAsync<ClienteNitResponse>(
                $"{ApiConfig.BaseUrl}/client/clients/nit/{nitBusqueda}");
            clienteEncontrado = response?.data;

            if (clienteEncontrado == null)
                mensajeError = "No se encontró ningún cliente con ese NIT.";
        }
        catch
        {
            mensajeError = "No se encontró ningún cliente con ese NIT.";
        }
    }


    async Task GenerarFactura()
    {
        mensajeError = null;
        if (clienteEncontrado == null || string.IsNullOrEmpty(ordenSeleccionadaId)) return;

        try
        {
            var payload = new Dictionary<string, object>
            {
                ["orden_id"] = ordenSeleccionadaId,
                ["cliente_nit"] = clienteEncontrado.nit
            };

            var response = await Http.PostAsJsonAsync(
                $"{ApiConfig.BaseUrl}/FacturaElectronica/facturas", payload);

            var result = await response.Content.ReadFromJsonAsync<FacturaResponse>();
            facturaGenerada = result?.data;

            showFacturaModal = true;

            var aceptada = facturaGenerada?.estado == "EMITIDA";
            toastEsExito = aceptada;
            toastMessage = aceptada
                ? $"Factura emitida — CUFE: {facturaGenerada?.cufe?[..12]}..."
                : "Factura generada, pero fue rechazada en la validación";
            showToast = true;
            StateHasChanged();

            _ = OcultarToastDespues(5000);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            mensajeError = "Error al generar la factura. Intente de nuevo.";
            toastEsExito = false;
            toastMessage = "No se pudo generar la factura";
            showToast = true;
            StateHasChanged();
            _ = OcultarToastDespues(5000);
        }
    }

    async Task OcultarToastDespues(int ms)
    {
        await Task.Delay(ms);
        showToast = false;
        StateHasChanged();
    }


    class Cliente
    {
        public int nit { get; set; }
        public string? nombre { get; set; }
        public string? correo { get; set; }
        public string? telefono { get; set; }
        public string? direccion { get; set; }
    }

    class Orden
    {
        public string? orden_id { get; set; }

        [JsonConverter(typeof(FlexibleStringConverter))]
        public string? mesa { get; set; }

        public string? estado_nombre { get; set; }
        public int total { get; set; }
        public string? fecha { get; set; }
        public string? hora { get; set; }
        public List<PlatoOrden> platos { get; set; } = new();
    }

    class PlatoOrden
    {
        public string? Descripcion { get; set; }
        public int cantidad { get; set; }
        public int subtotal { get; set; }
    }

    class FacturaData
    {
        public string? factura_id { get; set; }
        public int cliente_nit { get; set; }
        public string? cliente_nombre { get; set; }
        public string? cliente_correo { get; set; }
        public string? cliente_direccion { get; set; }
        [JsonConverter(typeof(FlexibleStringConverter))]
        public string? mesa { get; set; }
        public string? fecha { get; set; }
        public string? hora { get; set; }
        public List<PlatoOrden> platos { get; set; } = new();
        public int subtotal { get; set; }
        public int impuesto_consumo { get; set; }
        public int total { get; set; }
        public string? estado { get; set; }
        public string? cufe { get; set; }
        public string? ambiente_dian { get; set; }
        public List<string>? mensajes_validacion { get; set; }
    }

    class FlexibleStringConverter : JsonConverter<string>
    {
        public override string Read(ref Utf8JsonReader reader, Type typeToConvert, JsonSerializerOptions options)
        {
            if (reader.TokenType == JsonTokenType.Number)
                return reader.GetInt32().ToString();
            if (reader.TokenType == JsonTokenType.String)
                return reader.GetString() ?? "";
            if (reader.TokenType == JsonTokenType.True)
                return "true";
            if (reader.TokenType == JsonTokenType.False)
                return "false";
            return "";
        }

        public override void Write(Utf8JsonWriter writer, string value, JsonSerializerOptions options)
        {
            writer.WriteStringValue(value);
        }
    }

    class OrdenApiResponse { public List<Orden>? data { get; set; } }
    class ClienteNitResponse { public Cliente? data { get; set; } }
    class FacturaResponse { public FacturaData? data { get; set; } }
}