
@page "/caja"
@inject HttpClient Http
@inject SidebarService SidebarService
@implements IDisposable


    <!-- Contenido principal -->
    <div class="caja-content">

        <!-- Panel izquierdo: Crear orden -->
        <div class="panel-izquierdo">

            <!-- Selector de mesa -->
            <div class="mesa-selector">
                <label>Mesa</label>
                <select @bind="mesaSeleccionada">
                    @for (int i = 1; i <= 20; i++)
                    {
                        <option value="@i">Mesa @i</option>
                    }
                </select>
            </div>

            <!-- Cards de platos -->
            <div class="platos-grid">
                @foreach (var plato in platos)
                {
                    <div class="plato-card @(platosSeleccionados.ContainsKey(plato.plato_id) ? "seleccionado" : "")"
                         @onclick="() => TogglePlato(plato)">
                        <span class="plato-nombre">@plato.Descripcion</span>
                        <span class="plato-precio">$@plato.Precio</span>
                        @if (platosSeleccionados.ContainsKey(plato.plato_id))
                        {
                            <div class="cantidad-control" @onclick:stopPropagation="true">
                                <button @onclick="() => DecrementarCantidad(plato)">−</button>
                                <span>@platosSeleccionados[plato.plato_id]</span>
                                <button @onclick="() => IncrementarCantidad(plato)">+</button>
                            </div>
                        }
                    </div>
                }
            </div>

            <button class="btn-crear-orden" @onclick="CrearOrden">
                Crear Orden
            </button>
        </div>

        <!-- Panel derecho: Lista de órdenes en preparación -->
        <div class="panel-derecho">
            <h3>Órdenes en Preparación</h3>

            @if (ordenes.Count == 0)
            {
                <p class="sin-ordenes">No hay órdenes activas</p>
            }

            @foreach (var orden in ordenes)
            {
                <div class="orden-card">
                    <div class="orden-header">
                        <span class="orden-mesa">Mesa @orden.mesa</span>
                        <span class="orden-total">$@orden.total</span>
                    </div>
                    <div class="orden-platos">
                        @foreach (var p in orden.platos)
                        {
                            <span>@p.cantidad× @p.Descripcion</span>
                        }
                    </div>
                    <div class="orden-actions">
                        <button class="btn-editar" @onclick="() => AbrirEditar(orden)">
                            ✏️ Editar
                        </button>
                        <button class="btn-eliminar" @onclick="() => ConfirmarEliminarOrden(orden)">
                            🗑️
                        </button>
                        <button class="btn-cobrar" @onclick="() => AbrirCobrar(orden)">
                            Cobrar
                        </button>
                    </div>
                </div>
            }
        </div>

    </div>


@* Modal 1: Resumen del pedido *@
@if (showResumenModal)
{
    <div class="comfirm-overlay">
        <div class="comfirm-box" style="width:450px;">
            <h3 style="color:white; margin-bottom:20px;">
                Resumen — Mesa @ordenCobrar?.mesa
            </h3>

            @foreach (var p in ordenCobrar?.platos ?? new List<PlatoOrden>())
            {
                <div style="display:flex; justify-content:space-between;
                                    padding:8px 12px; background:#444;
                                    border-radius:10px; margin-bottom:8px; color:white;">
                    <span>@p.cantidad× @p.Descripcion</span>
                    <span>$@p.subtotal</span>
                </div>
            }

            <div style="margin-top:15px; padding:10px; background:#F28C45;
                            border-radius:10px; color:white; font-weight:bold;
                            display:flex; justify-content:space-between;">
                <span>Total</span>
                <span>$@ordenCobrar?.total</span>
            </div>

            <div style="display:flex; gap:10px; margin-top:20px; justify-content:center;">
                <button class="register-btn" style="background:gray; width:35%;"
                        @onclick="() => showResumenModal = false">
                    Cancelar
                </button>
                <button class="register-btn" style="width:45%;"
                        @onclick="AbrirPago">
                    Confirmar
                </button>
            </div>
        </div>
    </div>
}

@* Modal 2: Pago en efectivo *@
@if (showPagoModal)
{
    <div class="comfirm-overlay">
        <div class="comfirm-box" style="width:350px;">
            ...
            <div style="display:flex; gap:10px; justify-content:center;">
                <button class="register-btn" style="background:gray; width:35%;"
                        @onclick="() => showPagoModal = false">
                    Cancelar
                </button>
                <button class="register-btn" style="background:#555; width:40%;"
                        @onclick="ConfirmarPago">
                    Solo cobrar
                </button>
                <button class="register-btn" style="width:45%;"
                        @onclick="CobrarYFacturar">
                    Cobrar y facturar
                </button>
            </div>
        </div>
    </div>
}
@if (showEditarModal)
{
    <div class="comfirm-overlay">
        <div class="comfirm-box" style="width:600px; max-height:80vh; overflow-y:auto;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                <h3 style="margin:0; color:white;">Editar — Mesa @ordenEditando?.mesa</h3>
                <button @onclick="() => showEditarModal = false"
                        style="background:transparent; border:none; color:white;
                                   font-size:22px; cursor:pointer;">
                    ✕
                </button>
            </div>

            <!-- Platos actuales -->
            <h4 style="color:#ccc; margin-bottom:10px;">Platos en el pedido</h4>
            @foreach (var p in platosEditando)
            {
                <div style="display:flex; justify-content:space-between; align-items:center;
                                    padding:8px 12px; background:#444; border-radius:10px;
                                    margin-bottom:8px; color:white;">
                    <span>@p.Descripcion</span>
                    <div style="display:flex; align-items:center; gap:10px;">
                        <button @onclick="() => DecrementarEditar(p)"
                                style="width:26px; height:26px; border-radius:50%; border:none;
                                               background:#F28C45; color:white; cursor:pointer; font-size:16px;">
                            −
                        </button>
                        <span>@p.cantidad</span>
                        <button @onclick="() => IncrementarEditar(p)"
                                style="width:26px; height:26px; border-radius:50%; border:none;
                                               background:#F28C45; color:white; cursor:pointer; font-size:16px;">
                            +
                        </button>
                        <button @onclick="() => EliminarPlatoEditar(p)"
                                style="background:red; border:none; border-radius:10px;
                                               color:white; padding:4px 10px; cursor:pointer;">
                            🗑️
                        </button>
                    </div>
                </div>
            }

            <!-- Agregar platos nuevos -->
            <h4 style="color:#ccc; margin:15px 0 10px;">Agregar platos</h4>
            <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(120px,1fr)); gap:10px;">
                @foreach (var plato in platos)
                {
                    var yaEsta = platosEditando.Any(p => p.plato_id == plato.plato_id);
                    <div style="background:@(yaEsta ? "#F28C45" : "#555"); border-radius:12px;
                                        padding:10px; text-align:center; cursor:pointer; color:white;"
                         @onclick="() => AgregarPlatoEditar(plato)">
                        <div style="font-size:12px; font-weight:600;">@plato.Descripcion</div>
                        <div style="font-size:11px; opacity:0.8;">$@plato.Precio</div>
                    </div>
                }
            </div>

            <!-- Total actualizado -->
            <div style="margin-top:15px; padding:10px; background:#F28C45;
                            border-radius:10px; color:white; font-weight:bold;
                            display:flex; justify-content:space-between;">
                <span>Total actualizado</span>
                <span>$@platosEditando.Sum(p => p.Precio * p.cantidad)</span>
            </div>

            <div style="display:flex; gap:10px; margin-top:20px; justify-content:center;">
                <button class="register-btn" style="background:gray; width:35%;"
                        @onclick="() => showEditarModal = false">
                    Cancelar
                </button>
                <button class="register-btn" style="width:45%;"
                        @onclick="GuardarEdicion">
                    Guardar cambios
                </button>
            </div>
        </div>
    </div>
}

@if (showEliminarOrdenModal)
{
    <div class="comfirm-overlay">
        <div class="comfirm-box">
            <p>¿Está seguro que desea cancelar el pedido de la Mesa @ordenEliminar?.mesa?</p>
            <div class="modal-buttons">
                <button class="no" @onclick="() => showEliminarOrdenModal = false">No</button>
                <button class="yes" @onclick="EliminarOrdenConfirmado">Sí</button>
            </div>
        </div>
    </div>
}

@code {
    bool showEliminarOrdenModal = false;
    bool showEditarModal = false;
    Orden? ordenEliminar;
    Orden? ordenEditando;
    List<PlatoOrden> platosEditando = new();
    List<Plato> platos = new();
    List<Orden> ordenes = new();
    Dictionary<string, int> platosSeleccionados = new();
    int mesaSeleccionada = 1;

    bool showResumenModal = false;
    bool showPagoModal = false;
    Orden? ordenCobrar;
    int efectivoRecibido = 0;

    protected override async Task OnInitializedAsync()
    {
        SidebarService.SetButtons(null);
        await LoadPlatos();
        await LoadOrdenes();
    }
    public void Dispose()
    {
        
    }

    async Task LoadPlatos()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PlatoApiResponse>(
                $"{ApiConfig.BaseUrl}/Plato/Platos");
            platos = response?.data ?? new List<Plato>();
        }
        catch { platos = new List<Plato>(); }
    }

    async Task LoadOrdenes()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<OrdenApiResponse>(
                $"{ApiConfig.BaseUrl}/Orden/ordenes");
            ordenes = response?.data
                ?.Where(o => o.estado_nombre == "Preparacion")
                .ToList() ?? new List<Orden>();
        }
        catch { ordenes = new List<Orden>(); }
    }

    void TogglePlato(Plato plato)
    {
        if (platosSeleccionados.ContainsKey(plato.plato_id))
            platosSeleccionados.Remove(plato.plato_id);
        else
            platosSeleccionados[plato.plato_id] = 1;
    }

    void IncrementarCantidad(Plato plato)
    {
        if (platosSeleccionados.ContainsKey(plato.plato_id))
            platosSeleccionados[plato.plato_id]++;
    }

    void DecrementarCantidad(Plato plato)
    {
        if (platosSeleccionados.ContainsKey(plato.plato_id))
        {
            platosSeleccionados[plato.plato_id]--;
            if (platosSeleccionados[plato.plato_id] <= 0)
                platosSeleccionados.Remove(plato.plato_id);
        }
    }

    async Task CrearOrden()
    {
        if (platosSeleccionados.Count == 0) return;

        var platosPayload = platosSeleccionados.Select(kvp => new
        {
            plato_id = kvp.Key,
            cantidad = kvp.Value
        }).ToList();

        var payload = new Dictionary<string, object>
        {
            ["id_estado"] = 2, // 2 = Preparando
            ["mesa"] = mesaSeleccionada,
            ["platos"] = platosPayload
        };

        await Http.PostAsJsonAsync($"{ApiConfig.BaseUrl}/Orden/ordenes", payload);

        // Limpiar selección
        platosSeleccionados.Clear();
        mesaSeleccionada = 1;
        await LoadOrdenes();
    }

    void AbrirCobrar(Orden orden)
    {
        ordenCobrar = orden;
        efectivoRecibido = 0;
        showResumenModal = true;
        StateHasChanged();
    }

    void AbrirPago()
    {
        showResumenModal = false;
        showPagoModal = true;
        StateHasChanged();
    }

    async Task ConfirmarPago()
    {
        if (efectivoRecibido < (ordenCobrar?.total ?? 0)) return;

        // Cambiar estado a pagado (id_estado = 2)
        await Http.PatchAsJsonAsync(
            $"{ApiConfig.BaseUrl}/Orden/ordenes/{ordenCobrar.orden_id}/estado",
            new Dictionary<string, object> { ["id_estado"] = 4 }
        );

        showPagoModal = false;
        ordenCobrar = null;
        efectivoRecibido = 0;
        await LoadOrdenes();
    }
    void AbrirEditar(Orden orden)
    {
        ordenEditando = orden;
        // Copia profunda de los platos para no modificar el original
        platosEditando = orden.platos.Select(p => new PlatoOrden
        {
            plato_id = p.plato_id,
            Descripcion = p.Descripcion,
            Precio = p.Precio,
            cantidad = p.cantidad,
            subtotal = p.subtotal
        }).ToList();
        showEditarModal = true;
        StateHasChanged();
    }

    void IncrementarEditar(PlatoOrden p)
    {
        p.cantidad++;
        p.subtotal = p.Precio * p.cantidad;
        StateHasChanged();
    }

    void DecrementarEditar(PlatoOrden p)
    {
        if (p.cantidad > 1)
        {
            p.cantidad--;
            p.subtotal = p.Precio * p.cantidad;
        }
        else
        {
            platosEditando.Remove(p);
        }
        StateHasChanged();
    }

    void EliminarPlatoEditar(PlatoOrden p)
    {
        platosEditando.Remove(p);
        StateHasChanged();
    }

    void AgregarPlatoEditar(Plato plato)
    {
        var existente = platosEditando.FirstOrDefault(p => p.plato_id == plato.plato_id);
        if (existente != null)
        {
            existente.cantidad++;
            existente.subtotal = existente.Precio * existente.cantidad;
        }
        else
        {
            platosEditando.Add(new PlatoOrden
            {
                plato_id = plato.plato_id,
                Descripcion = plato.Descripcion,
                Precio = plato.Precio,
                cantidad = 1,
                subtotal = plato.Precio
            });
        }
        StateHasChanged();
    }

    async Task GuardarEdicion()
    {
        if (platosEditando.Count == 0) return;

        var nuevoTotal = platosEditando.Sum(p => p.Precio * p.cantidad);

        var payload = new Dictionary<string, object>
        {
            ["platos"] = platosEditando.Select(p => new
            {
                plato_id = p.plato_id,
                Descripcion = p.Descripcion,
                Precio = p.Precio,
                cantidad = p.cantidad,
                subtotal = p.Precio * p.cantidad
            }).ToList(),
            ["total"] = nuevoTotal
        };

        await Http.PutAsJsonAsync(
            $"{ApiConfig.BaseUrl}/Orden/ordenes/{ordenEditando.orden_id}",
            payload
        );

        showEditarModal = false;
        await LoadOrdenes();
    }

    void ConfirmarEliminarOrden(Orden orden)
    {
        ordenEliminar = orden;
        showEliminarOrdenModal = true;
        StateHasChanged();
    }

    async Task EliminarOrdenConfirmado()
    {
        await Http.DeleteAsync(
            $"{ApiConfig.BaseUrl}/Orden/ordenes/{ordenEliminar.orden_id}"
        );
        showEliminarOrdenModal = false;
        ordenEliminar = null;
        await LoadOrdenes();
    }
    async Task CobrarYFacturar()
    {
        await ConfirmarPago();
        Nav.NavigateTo($"/factura?orden_id={ordenCobrar?.orden_id}");
    }

    class Plato
    {
        public string? plato_id { get; set; }
        public string? Descripcion { get; set; }
        public int Precio { get; set; }
    }

    class PlatoOrden
    {
        public string? plato_id { get; set; }
        public string? Descripcion { get; set; }
        public int cantidad { get; set; }
        public int subtotal { get; set; }
        public int Precio { get; set; }
    }

    class Orden
    {
        public string? orden_id { get; set; }
        public int mesa { get; set; }
        public string? estado_nombre { get; set; }
        public int total { get; set; }
        public List<PlatoOrden> platos { get; set; } = new();
    }

    class PlatoApiResponse { public List<Plato>? data { get; set; } }
    class OrdenApiResponse { public List<Orden>? data { get; set; } }
}
