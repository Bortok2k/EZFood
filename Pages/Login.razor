@page "/login"
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<div style="display:flex; width:100vw; height:100vh;
            justify-content:center; align-items:center;
            background:#d9d9d9;">
    <div style="background:white; border-radius:20px; padding:40px;
                width:380px; box-shadow:0 4px 20px rgba(0,0,0,0.1);">

        <div style="text-align:center; margin-bottom:30px;">
            <div style="font-size:48px;">🍽️</div>
            <h2 style="margin:10px 0 5px;">EZFood</h2>
            <p style="color:#888; font-size:14px; margin:0;">
                Santa Clara Gourmet
            </p>
        </div>

        <div style="display:flex; flex-direction:column; gap:15px;">
            <div>
                <label style="font-size:13px; color:#555;">Usuario</label>
                <input @bind="username"
                       placeholder="Ingresa tu usuario"
                       style="width:100%; padding:10px 15px; border-radius:20px;
                              border:1px solid #ddd; margin-top:5px; box-sizing:border-box;" />
            </div>
            <div>
                <label style="font-size:13px; color:#555;">Contraseña</label>
                <input @bind="password" type="password"
                       placeholder="Ingresa tu contraseña"
                       @onkeydown="OnKeyDown"
                       style="width:100%; padding:10px 15px; border-radius:20px;
                              border:1px solid #ddd; margin-top:5px; box-sizing:border-box;" />
            </div>

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <p style="color:red; font-size:13px; text-align:center; margin:0;">
                    @errorMsg
                </p>
            }

            <button @onclick="DoLogin"
                    disabled="@cargando"
                    style="background:#F28C45; border:none; padding:12px;
                           border-radius:20px; color:white; font-size:15px;
                           font-weight:600; cursor:pointer; width:100%;">
                @(cargando ? "Ingresando..." : "Ingresar")
            </button>
        </div>
    </div>
</div>

@code {
    string username = "";
    string password = "";
    string errorMsg = "";
    bool cargando = false;

    async Task DoLogin()
    {
        if (string.IsNullOrWhiteSpace(username) ||
            string.IsNullOrWhiteSpace(password)) return;

        cargando = true;
        errorMsg = "";
        StateHasChanged();

        try
        {
            var payload = new Dictionary<string, string>
            {
                ["user_name"] = username,
                ["password"] = password
            };

            var response = await Http.PostAsJsonAsync(
                $"{ApiConfig.BaseUrl}/auth", payload);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content
                    .ReadFromJsonAsync<LoginResponse>();
                AuthState.Init(JS);
                // Guardar en sesión
                await AuthState.SaveSession(
                    result.token,
                    result.user.user_name,
                    result.user.rol
                    );

                // Redirigir según rol
                if (result.user.rol == 1)
                    Nav.NavigateTo("/");
                else if (result.user.rol == 2)
                    Nav.NavigateTo("/caja");
                else
                    errorMsg = "No tiene acceso al sistema.";
            }
            else
            {
                errorMsg = "Usuario o contraseña incorrectos.";
            }
        }
        catch
        {
            errorMsg = "Error al conectar con el servidor.";
        }

        cargando = false;
        StateHasChanged();
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoLogin();
    }

    class LoginResponse
    {
        public UserInfo user { get; set; }
        public string token { get; set; }
    }

    class UserInfo
    {
        public string user_name { get; set; }
        public int rol { get; set; }
    }
}
