@page "/"
@implements IDisposable
@inject SidebarService SidebarService
    <!-- Content -->
    <div class="content">

        <div class="grid">

            <div class="card active" @onclick="@(() => GoTo("/caja"))">
                <div class="icon">💻</div>
                <p>Caja</p>
            </div>

            <div class="card" @onclick="@(() => GoTo("/factura"))">
                <div class="icon">📄</div>
                <p>Factura Electrónica</p>
            </div>

            <div class="card" @onclick="@(() => GoTo("/gestion"))">
                <div class="icon">📋</div>
                <p>Gestión</p>
            </div>

            <div class="card" @onclick="@(() => GoTo("/ezbot"))">
                <div class="icon">🤖</div>
                <p>EZBot</p>
            </div>

        </div>

    </div>



@code{
    protected override async Task OnInitializedAsync()
    {
        SidebarService.SetButtons(null);
    }
    public void Dispose()
    {
    }
    void GoTo(string url)
    {
        Nav.NavigateTo(url);
    }
}
