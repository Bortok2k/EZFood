@page "/Ezbot"
@inject HttpClient Http
@inject SidebarService SidebarService

    <div class="content" style="display:flex; flex-direction:column; gap:15px; overflow:hidden;">

        <!-- Título -->
        <div style="text-align:center;">
            <div style="font-size:40px;">🤖</div>
            <h2 style="margin:5px 0;">EZBot</h2>
            <p style="color:#666; font-size:13px;">Asistente de inteligencia de negocio</p>
        </div>
    <!-- Selector de modo -->
    <div class="modo-selector">
        <button class="btn-modo @(modoActual == "general" ? "activo" : "")"
                @onclick='() => CambiarModo("general")'>
            🤖 General
        </button>
        <button class="btn-modo @(modoActual == "administrador" ? "activo" : "")"
                @onclick='() => CambiarModo("administrador")'>
            📋 Administrador
        </button>
        <button class="btn-modo @(modoActual == "financiero" ? "activo" : "")"
                @onclick='() => CambiarModo("financiero")'>
            💰 Financiero
        </button>
    </div>
        <!-- Historial de chat -->
        <div class="chat-historial">
            @if (mensajes.Count == 0)
            {
                <div class="chat-sugerencias">
                    <p>Puedes preguntarme cosas como:</p>
                    <div class="sugerencia" @onclick='() => EnviarSugerencia("¿Cuál es el balance actual del restaurante?")'>
                        💰 ¿Cuál es el balance actual?
                    </div>
                    <div class="sugerencia" @onclick='() => EnviarSugerencia("¿Cuál es el plato más vendido?")'>
                        🍽️ ¿Cuál es el plato más vendido?
                    </div>
                    <div class="sugerencia" @onclick='() => EnviarSugerencia("¿En qué insumos se gasta más dinero?")'>
                        📦 ¿En qué insumos se gasta más?
                    </div>
                    <div class="sugerencia" @onclick='() => EnviarSugerencia("Dame recomendaciones para mejorar las ganancias")'>
                        📈 Recomendaciones para mejorar ganancias
                    </div>
                </div>
            }

            @foreach (var mensaje in mensajes)
            {
                <div class="mensaje @(mensaje.EsUsuario ? "mensaje-usuario" : "mensaje-bot")">
                    <div class="mensaje-contenido">
                        @if (!mensaje.EsUsuario)
                        {
                            <span class="bot-icon">🤖</span>
                        }
                        <div class="mensaje-texto">@mensaje.Texto</div>
                    </div>
                </div>
            }

            @if (cargando)
            {
                <div class="mensaje mensaje-bot">
                    <div class="mensaje-contenido">
                        <span class="bot-icon">🤖</span>
                        <div class="mensaje-texto typing">
                            <span></span><span></span><span></span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Input -->
        <div class="chat-input">
            <input placeholder="Escribe tu pregunta..."
                   value="@preguntaActual"
                   @oninput="e => preguntaActual = e.Value?.ToString()"
                   @onkeydown="OnKeyDown"
                   disabled="@cargando" />
            <button @onclick="Enviar" disabled="@cargando">
                @(cargando ? "..." : "➤")
            </button>
        </div>

    </div>

@code {
    List<Mensaje> mensajes = new();
    string preguntaActual = "";
    bool cargando = false;

    string modoActual = "general";

    void CambiarModo(string modo)
    {
        modoActual = modo;
        // Limpiar chat al cambiar modo
        mensajes.Clear();
        StateHasChanged();
    }

    async Task Enviar()
    {
        if (string.IsNullOrWhiteSpace(preguntaActual) || cargando) return;

        var pregunta = preguntaActual;
        preguntaActual = "";

        mensajes.Add(new Mensaje { Texto = pregunta, EsUsuario = true });
        cargando = true;
        StateHasChanged();

        try
        {
            var payload = new Dictionary<string, string>
            {
                ["pregunta"] = pregunta,
                ["modo"] = modoActual  // ← agregar modo
            };

            var response = await Http.PostAsJsonAsync(
                "http://localhost:8080/api/v1/EZBot/consultar", payload);

            var result = await response.Content.ReadFromJsonAsync<EZBotResponse>();
            mensajes.Add(new Mensaje
            {
                Texto = result?.respuesta ?? "No pude obtener una respuesta.",
                EsUsuario = false
            });
        }
        catch
        {
            mensajes.Add(new Mensaje
            {
                Texto = "Hubo un error al conectar con EZBot.",
                EsUsuario = false
            });
        }

        cargando = false;
        StateHasChanged();
    }

    async Task EnviarSugerencia(string sugerencia)
    {
        preguntaActual = sugerencia;
        await Enviar();
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Enviar();
    }

    class Mensaje
    {
        public string Texto { get; set; }
        public bool EsUsuario { get; set; }
    }

    class EZBotResponse
    {
        public string respuesta { get; set; }
    }



}
