@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject SidebarService SidebarService
@inject IJSRuntime JS
@implements IDisposable

<div class="main-layout">
    <div class="sidebar">
        <div class="profile-circle"
             style="@(AuthState.IsAdmin ? "cursor:pointer;" : "cursor:default;")"
             @onclick="IrAHome">
        </div>

        @if (AuthState.IsAuthenticated)
        {
            <span style="color:white; font-size:13px; text-align:center; padding:0 10px;">
                @AuthState.UserName
            </span>
        }

        @if (SidebarService.SidebarButtons != null)
        {
            @SidebarService.SidebarButtons
        }

        @if (AuthState.IsAuthenticated)
        {
            <button class="side-button"
                    style="background:#cc4444; margin-top:auto; margin-bottom:20px;"
                    @onclick="CerrarSesion">
                Cerrar sesión
            </button>
        }
    </div>

    <div class="main-content">
        @if (!cargandoSesion)
        {
            @Body
        }
    </div>
</div>





@code {
    bool cargandoSesion = true;

    protected override async Task OnInitializedAsync()
    {
        SidebarService.OnChange += StateHasChanged;

        if (!AuthState.IsAuthenticated)
        {
            var datos = await JS.InvokeAsync<AuthData>("authStorage.get");
            if (!string.IsNullOrEmpty(datos.token))
            {
                AuthState.Token = datos.token;
                AuthState.UserName = datos.userName;
                AuthState.Rol = datos.rol;
            }
        }

        cargandoSesion = false;

        var uri = Nav.Uri;
        var isLoginPage = uri.Contains("/login");

        if (!isLoginPage && !AuthState.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
        }
    }

    async Task CerrarSesion()
    {
        AuthState.Logout();
        await JS.InvokeVoidAsync("authStorage.clear");
        Nav.NavigateTo("/login");
    }

    void IrAHome()
    {
        if (AuthState.IsAdmin)
            Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        SidebarService.OnChange -= StateHasChanged;
    }

    class AuthData
    {
        public string token { get; set; } = "";
        public string userName { get; set; } = "";
        public int rol { get; set; }
    }
}